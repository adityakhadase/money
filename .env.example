# PostgreSQL Database Connection URL (e.g. Neon, Supabase, Vercel Postgres, Railway)
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# Resend API Key for reminder and weekly summary emails (optional)
RESEND_API_KEY=""

# Twilio Credentials for WhatsApp messaging (optional)
